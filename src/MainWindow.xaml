<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BHops Optimizer" Width="1180" Height="820" MinWidth="1000" MinHeight="700" Background="#0B1020" Foreground="#E8EDF7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#25334D"/><Setter Property="Foreground" Value="#ECF2FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#52E0B4"/><Setter Property="Foreground" Value="#082B24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,4"/><Setter Property="Background" Value="#141D30"/><Setter Property="Padding" Value="14,13"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3FE"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#17243C"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A1AFC8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#151F34"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#151F34"/><Setter Property="Foreground" Value="#E8EDF7"/><Setter Property="RowBackground" Value="#151F34"/><Setter Property="AlternatingRowBackground" Value="#1A2840"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#25334D"/><Setter Property="Foreground" Value="#AFC0DA"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#10182B" Padding="20,26">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="BHops" FontSize="30" FontWeight="Bold" Foreground="#52E0B4"/><TextBlock Text="OPTIMIZER" FontSize="12" Foreground="#A1AFC8" Margin="2,3,0,30"/>
          <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Content="Overview"/>
          <Button x:Name="NavNetwork" Style="{StaticResource NavButton}" Content="Network"/>
          <Button x:Name="NavSystem" Style="{StaticResource NavButton}" Content="System"/>
          <Button x:Name="NavGaming" Style="{StaticResource NavButton}" Content="Gaming"/>
          <Button x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Content="Diagnostics"/>
          <Button x:Name="NavDrivers" Style="{StaticResource NavButton}" Content="Drivers"/>
          <Button x:Name="NavBackups" Style="{StaticResource NavButton}" Content="Backups"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,30,0,0">
          <TextBlock Text="Open source. Your choices." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
          <Button x:Name="OpenRepository" Content="GitHub / source" Background="#1B2942" Padding="10,9" FontSize="12"/>
          <TextBlock Text="v0.1.0  /  MIT license" Foreground="#7D91AF" FontSize="11" Margin="2,15,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,25,30,18">
      <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="102"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <StackPanel><TextBlock x:Name="PageTitle" Text="Your PC, with a plan." FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Inspect first. Apply supported changes. Keep an undo path." Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C2F35" CornerRadius="6" Padding="10,6"><TextBlock x:Name="PrivilegeStatus" Text="Read-only until you apply" Foreground="#78E6C4" FontSize="12"/></Border>
      </Grid>
      <Border x:Name="DemoBanner" Grid.Row="1" Background="#5D4919" CornerRadius="7" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock Text="DEMO PREVIEW — sample data, changes are disabled." Foreground="#FFE3A0"/></Border>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <Grid>
          <StackPanel x:Name="PageOverview">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A practical tuning toolkit" Style="{StaticResource Heading}"/><TextBlock Text="Choose network, Windows, or gaming settings. BHops Optimizer checks the capabilities of your PC, saves original values, and runs changes in the background." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="OverviewNetwork" Content="Tune Wi-Fi" Style="{StaticResource PrimaryButton}"/><Button x:Name="OverviewGaming" Content="Gaming selection"/><Button x:Name="OverviewDiagnose" Content="Measure latency"/></StackPanel></StackPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CONNECTED ADAPTER" Foreground="#7F95B6" FontSize="11"/><TextBlock x:Name="OverviewAdapter" Text="Checking your hardware…" FontSize="18" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock x:Name="OverviewAdapterDetail" Text="Driver, link, and supported settings will appear here." Style="{StaticResource Muted}"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="BACKUP STATUS" Foreground="#7F95B6" FontSize="11"/><TextBlock x:Name="OverviewBackupCount" Text="No changes made" FontSize="18" Margin="0,12,0,10"/><TextBlock Text="A snapshot is saved before every change. Undo restores the original values for that operation." Style="{StaticResource Muted}"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="How it works" Style="{StaticResource Heading}"/><TextBlock Text="1   Choose a selection and preview the exact changes.&#10;2   Apply once; unsupported settings are skipped.&#10;3   Compare connection tests and use Backups to undo." Style="{StaticResource Muted}"/><TextBlock Text="You control when changes and driver updates run. The app never schedules a reboot or runs at startup." Foreground="#7F95B6" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Wireless adapter" Style="{StaticResource Heading}"/><ComboBox x:Name="AdapterSelector" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock x:Name="AdapterDetail" Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Select a physical Wi-Fi adapter."/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="Gaming Wi-Fi selection" Style="{StaticResource Heading}"/><Button x:Name="NetworkRecommended" Content="Select recommended" HorizontalAlignment="Right" Padding="12,7" FontSize="12"/></DockPanel><TextBlock Text="Reduce power transitions and roaming on a stationary PC. Prefer 5 GHz while keeping other bands available as a fallback." Style="{StaticResource Muted}" Margin="0,0,0,20"/><StackPanel x:Name="NetworkOptions"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="NetworkPreview" Content="Preview changes"/><Button x:Name="NetworkApply" Content="Apply selected" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border>
            <Border x:Name="NetworkPlanCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Proposed changes" Style="{StaticResource Heading}"/><TextBox x:Name="NetworkPlanText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#CEDAF0" BorderThickness="0" VerticalScrollBarVisibility="Auto" MinHeight="60" MaxHeight="230"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageSystem" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows preferences" Style="{StaticResource Heading}"/><TextBlock Text="Make Windows easier to use, adjust animations, and choose optional privacy preferences. Original values are saved for each operation; privacy choices do not claim an FPS improvement." Style="{StaticResource Muted}" Margin="0,0,0,22"/><StackPanel x:Name="SystemOptions"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="SystemPreview" Content="Preview changes"/><Button x:Name="SystemApply" Content="Apply selected" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border>
            <Border x:Name="SystemPlanCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Proposed changes" Style="{StaticResource Heading}"/><TextBox x:Name="SystemPlanText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#CEDAF0" BorderThickness="0" MinHeight="60" MaxHeight="250" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageGaming" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gaming selection" Style="{StaticResource Heading}"/><TextBlock Text="Enable Game Mode and stop background recording. Mouse acceleration and the performance power plan are separate choices so you can preserve your preferred desktop behaviour." Style="{StaticResource Muted}" Margin="0,0,0,22"/><StackPanel x:Name="GamingOptions"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="GamingPreview" Content="Preview changes"/><Button x:Name="GamingApply" Content="Apply gaming selection" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border>
            <Border x:Name="GamingPlanCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Proposed changes" Style="{StaticResource Heading}"/><TextBox x:Name="GamingPlanText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#CEDAF0" BorderThickness="0" MinHeight="60" MaxHeight="250" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Playing over Wi-Fi?" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The Network section has its own Gaming Wi-Fi selection. Run a latency test before and after changing it." Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button x:Name="GamingNetwork" Content="Open network selection" HorizontalAlignment="Left"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Find where latency changes" Style="{StaticResource Heading}"/><TextBlock Text="Test the router alongside two internet endpoints. Spikes at the router suggest a local connection or host issue; internet-only variation may need a different investigation." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><ComboBox x:Name="SampleSelector" Width="155" SelectedIndex="0"><ComboBoxItem Content="100 probes" Tag="100"/><ComboBoxItem Content="250 probes" Tag="250"/><ComboBoxItem Content="500 probes" Tag="500"/></ComboBox><Button x:Name="RunDiagnostics" Content="Run latency test" Style="{StaticResource PrimaryButton}"/><Button x:Name="ExportDiagnostics" Content="Save report" IsEnabled="False"/></StackPanel><TextBlock Text="ICMP uses Windows routing, including active VPNs. The selected adapter supplies its gateway and traffic counters. Short tests record background traffic and do not guarantee in-game latency." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DiagnosticSummary" Text="Run a test to see loss, latency, and variation." Style="{StaticResource Heading}" FontSize="18"/><DataGrid x:Name="LatencyGrid" MinHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="Avg ms" Binding="{Binding MeanMs}" Width="85"/><DataGridTextColumn Header="95% ms" Binding="{Binding P95Ms}" Width="85"/><DataGridTextColumn Header="Max ms" Binding="{Binding MaxMs}" Width="85"/><DataGridTextColumn Header="Loss %" Binding="{Binding LossPercent}" Width="85"/><DataGridTextColumn Header="RTT delta" Binding="{Binding MeanSuccessiveRttDifferenceMs}" Width="95"/></DataGrid.Columns></DataGrid><TextBlock x:Name="DiagnosticContext" Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0" Text="RTT delta is the mean absolute change between consecutive successful ping replies."/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageDrivers" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compatible drivers, checked first" Style="{StaticResource Heading}"/><TextBlock x:Name="DriverInstalled" Text="Select a Wi-Fi adapter in Network, then check drivers." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="CheckDrivers" Content="Check supported updates" Style="{StaticResource PrimaryButton}"/><Button x:Name="OpenCatalog" Content="Search Microsoft Catalog"/><Button x:Name="OpenDeviceManager" Content="Device Manager"/></StackPanel><TextBlock Text="Automatic installation is available for reviewed hardware IDs. Downloads are checked against the manifest, INF compatibility, and Microsoft signatures. The current driver is exported before installing an update." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DriverStatus" Text="No update check yet" Style="{StaticResource Heading}" FontSize="18"/><DataGrid x:Name="DriverGrid" MinHeight="130" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Driver" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Reason}" Width="230"/></DataGrid.Columns></DataGrid><Button x:Name="InstallDriver" Content="Install selected verified update" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" IsEnabled="False"/><TextBlock Text="A driver update can reconnect Wi-Fi and may need a PC restart. Restart remains your choice." Style="{StaticResource Muted}" FontSize="12" Margin="0,15,0,0"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageBackups" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Undo with the original values" Style="{StaticResource Heading}"/><TextBlock Text="Choose an operation to restore. Backups are bound to your machine and adapter. Network and Windows snapshots stay separate from driver-package backups." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="RefreshBackups" Content="Refresh backups"/><Button x:Name="OpenStateFolder" Content="Open local data folder"/><Button x:Name="RestoreBackup" Content="Restore selected" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><DataGrid x:Name="BackupGrid" MinHeight="220" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="180"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Adapter / selection" Binding="{Binding AdapterName}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Text="Restoring settings preserves the installed driver. Use Device Manager for driver rollback; exported driver packages are stored in the local data folder." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" Background="#111A2E" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="OperationStatus" Text="Ready. No changes are applied on launch." Foreground="#A9BBD8" FontSize="12"/><ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="3" IsIndeterminate="True" Foreground="#52E0B4" Background="#1B2A44" Visibility="Hidden"/><TextBox x:Name="ActivityText" Grid.Row="2" Background="Transparent" Foreground="#7E95B9" BorderThickness="0" IsReadOnly="True" FontSize="11" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" TextWrapping="Wrap"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
